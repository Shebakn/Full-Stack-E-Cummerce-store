{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "outDir": "./dist",
    "rootDir": "./src",

    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}